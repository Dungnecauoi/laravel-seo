{
  "name": "@duxbo/seo-core",
  "version": "0.9.0",
  "description": "Framework-agnostic client for the Laravel SEO package. Types, API client and state helpers \u2014 no rendering.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist-test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "seo",
    "laravel",
    "headless",
    "meta-tags",
    "schema-org"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dungnecauoi/laravel-seo.git",
    "directory": "js"
  }
}
